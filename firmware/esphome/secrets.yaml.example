# Copy to secrets.yaml (gitignored) and fill in your own values.
wifi_ssid: "example-ssid"
wifi_password: "example-password"

# Password of the node's own setup hotspot (`<name>-setup`), at least 8 characters. Whoever joins
# that hotspot can move the node to another network, so do not leave the placeholder in.
wifi_ap_password: "example-hotspot-password"

# API encryption key: 32 bytes in base64. The value below is 32 zero bytes. It is a PLACEHOLDER
# and it is PUBLIC (it is in this repository), so a node built with it can be controlled by
# anyone on its network. It only exists so a fresh clone can validate and build. Replace it before
# pairing with Home Assistant, with a key of your own:
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# or let ESPHome's dashboard write one when it adopts the node.
hisense_ac__encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
