<?xml version="1.0"?>
<!--
  Manufacturer-specific cluster for the Hisense W41H1 A/C "exotic" toggles that
  have no standard Matter home: eco / turbo / mute / sleep, plus two read-only
  telemetry fields. Modeled on chip/sample-mei-cluster.xml.

  <code> = (VendorID << 16) | ClusterID.  0xFFF1 is the CSA test VendorID (matches
  the device's attestation VID); 0xFC00 is our self-assigned manufacturer cluster.
-->
<configurator>
  <domain name="CHIP"/>

  <cluster>
    <domain>General</domain>
    <name>Hisense Aircon</name>
    <code>0xFFF1FC00</code>
    <define>HISENSE_AIRCON_CLUSTER</define>
    <description>W41H1 vendor toggles: eco/turbo/mute/sleep + read-only telemetry.</description>

    <attribute side="server" code="0x0000" define="ECO"           type="boolean" writable="true"  default="false" optional="false">Eco</attribute>
    <attribute side="server" code="0x0001" define="TURBO"         type="boolean" writable="true"  default="false" optional="false">Turbo</attribute>
    <attribute side="server" code="0x0002" define="MUTE"          type="boolean" writable="true"  default="false" optional="false">Mute</attribute>
    <attribute side="server" code="0x0003" define="SLEEP_PROFILE" type="int8u"   writable="true"  default="0"     optional="false">SleepProfile</attribute>
    <attribute side="server" code="0x0010" define="COMPRESSOR_HZ" type="int8u"   writable="false" default="0"     optional="true">CompressorHz</attribute>
    <attribute side="server" code="0x0011" define="OUTDOOR_TEMP"  type="int8s"   writable="false" default="0"     optional="true">OutdoorTemp</attribute>
    <!-- Packed diagnostics for the HACS integration (docs/14). int32u so bit 31 (VALID) is not
         a sign bit. Features1 = HisenseFeatures (15 capability fields); Faults1 = HisenseFaults
         (18 f_e_* bits). Bit layouts are the HISENSE_FEAT1_*/HISENSE_FAULT1_* contract in
         hisense_rs485.h, mirrored by the integration's const.py + a host test. -->
    <attribute side="server" code="0x0012" define="FEATURES1"     type="int32u"  writable="false" default="0"     optional="true">Features1</attribute>
    <attribute side="server" code="0x0013" define="FAULTS1"       type="int32u"  writable="false" default="0"     optional="true">Faults1</attribute>
    <!-- RS-485 bus diagnostics, the Matter side of the ESPHome build's diagnostic sensors
         (firmware/docs/14). The four counters run from boot and reset to 0 on a reboot.
         ChecksumErrors: 0x66 frames that passed framing but failed the checksum.
         ReplyTimeouts: reply windows that closed empty, any frame class.
         UnansweredCommands: queued command frames among those (the write is lost, nothing resends it).
         LinkLosses: link-lost edges (five silent status polls in a row).
         LinkToken: the A/C's (device type, sub type) pair, high byte first; 0 until its DevType reply.
         BusLink: true while status polls are answered. -->
    <attribute side="server" code="0x0014" define="CHECKSUM_ERRORS"     type="int32u"  writable="false" default="0" optional="true">ChecksumErrors</attribute>
    <attribute side="server" code="0x0015" define="REPLY_TIMEOUTS"      type="int32u"  writable="false" default="0" optional="true">ReplyTimeouts</attribute>
    <attribute side="server" code="0x0016" define="UNANSWERED_COMMANDS" type="int32u"  writable="false" default="0" optional="true">UnansweredCommands</attribute>
    <attribute side="server" code="0x0017" define="LINK_LOSSES"         type="int32u"  writable="false" default="0" optional="true">LinkLosses</attribute>
    <attribute side="server" code="0x0018" define="LINK_TOKEN"          type="int16u"  writable="false" default="0" optional="true">LinkToken</attribute>
    <attribute side="server" code="0x0019" define="BUS_LINK"            type="boolean" writable="false" default="false" optional="true">BusLink</attribute>

    <command source="client" code="0x00" name="Refresh" optional="true">
      <description>No-op; present so the cluster attaches to an endpoint.</description>
    </command>
  </cluster>
</configurator>
