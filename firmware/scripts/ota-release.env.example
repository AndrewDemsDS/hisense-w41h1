# Settings for `dev.py convert` and the `dev.py matter-*` commands: the tools that move a stock
# module off the retired Matter firmware. Copy to `ota-release.env` (gitignored) and fill in.
# Nothing here is needed to build, flash or update the ESPHome firmware itself.
# Keep real hostnames and paths OUT of git.

# --- wrapping the ESPHome image as a Matter .ota (dev.py convert) ---
# connectedhomeip's ota_image_tool.py, from any checkout of project-chip/connectedhomeip
# (src/app/ota_image_tool.py). It is not part of this repo.
OTA_TOOL="$HOME/connectedhomeip/src/app/ota_image_tool.py"
# The identity the Matter firmware on the unit was built with (test credentials).
VID="0xFFF1"
PID="0x8001"

# --- AmebaZ2 slot-selection serial ---
# The bootloader boots the valid slot with the HIGHER FWHS serial, not the Matter softwareVersion.
# The Matter builds used serial = SERIAL_BASE + softwareVersion, and `convert` follows the same
# rule so the ESPHome image lands above the running one. Use the value the unit's Matter image
# was built with.
SERIAL_BASE="1100"

# --- OTA provider host (dev.py convert --stage; the machine running python-matter-server) ---
PI_HOST="root@your-ha-host.local"
PI_OTA_DIR="/path/to/matter-server/ota"        # matches matter-server --ota-provider-dir
PI_SSH_KEY="$HOME/.ssh/id_ed25519"
# OTA_KEEP_MANIFESTS=1 stages without archiving this product's other manifests.

# --- break-glass listener of the Matter firmware (dev.py matter-slots, matter-backup) ---
# The token and port compiled into the Matter image the unit runs. There is no default token.
BREAKGLASS_TOKEN=""
BREAKGLASS_PORT=2324
