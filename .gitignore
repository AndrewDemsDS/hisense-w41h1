# === Secrets / private data — NEVER commit ===
# Raw flash dumps contain provisioned Wi-Fi credentials + the device RSA key,
# plus the copyrighted vendor firmware blob.
*.bin
*.img
*.der
*.key
# Strings / analysis dumps may contain credentials
strings.txt
strings*.txt

# The entire dumps/ dir is local-only (raw dumps + captures). Track only its README.
/dumps/*

# Raw RE analysis workspace (carved images, agent notes) — docs/13 is the deliverable
/reverse-engineering/analysis/
!/dumps/README.md

# Live captures
capture_*.log
*.cap

# Build output / firmware artifacts (regenerable; some contain factory secrets)
**/build/
*.ota
# built-images/ is entirely generated (slot backups, conversion images and their
# provider manifests): none of it belongs in git.
firmware/built-images/

# Python
__pycache__/
*.pyc

# Editor / OS
.DS_Store
firmware/scripts/ota-release.env

# --- Public-release excludes (added for open-source prep) ---
# Private working notes — never publish (per project convention).
# RELEASE.md is internal release-prep scaffolding (names a private mirror path);
# README/NOTICE/CONTRIBUTING cover everything public.
/CLAUDE.md
/AGENTS.md
/RELEASE.md
# Editor settings — not part of the public deliverable
/.vscode/
# compiled host-test binaries (build artifacts), and the objects the parity layer links, which
# stay behind when that link fails
/firmware/test/*.o
/firmware/test/test_codec
/firmware/test/test_reference_map
/firmware/test/test_esphome_map
/firmware/test/test_esphome_codec_parity
/firmware/test/test_esphome_bus
/firmware/test/test_esphome_edge_cases
/firmware/test/test_esphome_confirm
/firmware/test/test_esphome_uart_policy

# python lint cache
.ruff_cache/
_site_src/

# ESPHome: generated build tree + the local secrets file (secrets.yaml.example is tracked)
/firmware/esphome/.esphome/
/firmware/esphome/secrets.yaml
